#version 300 es

#define HLSLCC_ENABLE_UNIFORM_BUFFERS 1
#if HLSLCC_ENABLE_UNIFORM_BUFFERS
#define UNITY_UNIFORM
#else
#define UNITY_UNIFORM uniform
#endif
#define UNITY_SUPPORTS_UNIFORM_LOCATION 0
#if UNITY_SUPPORTS_UNIFORM_LOCATION
#define UNITY_LOCATION(x) layout(location = x)
#define UNITY_BINDING(x) layout(binding = x, std140)
#else
#define UNITY_LOCATION(x)
#define UNITY_BINDING(x) layout(std140)
#endif
uniform 	vec3 _WorldSpaceCameraPos;
uniform 	mediump vec4 unity_SHAr;
uniform 	mediump vec4 unity_SHAg;
uniform 	mediump vec4 unity_SHAb;
uniform 	mediump vec4 unity_SHBr;
uniform 	mediump vec4 unity_SHBg;
uniform 	mediump vec4 unity_SHBb;
uniform 	mediump vec4 unity_SHC;
uniform 	vec4 hlslcc_mtx4x4unity_ObjectToWorld[4];
uniform 	vec4 hlslcc_mtx4x4unity_WorldToObject[4];
uniform 	vec4 hlslcc_mtx4x4unity_MatrixVP[4];
uniform 	vec4 hlslcc_mtx4x4_StaticShadowMatrix[4];
uniform 	float _StaticShadowBias;
uniform 	float _StaticShadowStrength;
uniform 	float _StaticShadowFadeEnd;
uniform 	float _StaticShadowFadeInvRange;
uniform 	vec3 _ShadowFadeLightDir;
uniform 	vec4 hlslcc_mtx4x4_DynamicShadowMatrix[4];
uniform 	float _DynamicShadowBias;
uniform 	float _DynamicShadowStrength;
uniform 	float _DynamicShadowFadeEnd;
uniform 	float _DynamicShadowFadeInvRange;
uniform 	float _FogStart;
uniform 	float _FogRcpRange;
uniform 	mediump vec4 _SkyboxTopColor;
uniform 	mediump vec4 _SkyboxHorizonColor;
uniform 	mediump vec4 _SkyboxBottomColor;
uniform 	float _FogEditorMultiplier;
uniform 	mediump vec4 _GlobalMainColor[4];
uniform 	mediump vec4 _GlobalSideColor[4];
uniform 	float _GlobalTopSpreadsArr[4];
uniform 	float _GlobalTransitionDist;
uniform 	float _GlobalDistArr[3];
in highp vec4 in_POSITION0;
in highp vec3 in_NORMAL0;
out highp vec3 vs_TEXCOORD0;
out mediump vec4 vs_TEXCOORD1;
out mediump vec3 vs_TEXCOORD2;
out mediump vec4 vs_TEXCOORD3;
out highp vec4 vs_TEXCOORD4;
out mediump vec4 vs_TEXCOORD5;
out mediump vec4 vs_TEXCOORD6;
out highp vec4 vs_TEXCOORD7;
vec4 u_xlat0;
vec4 u_xlat1;
vec4 u_xlat2;
mediump vec3 u_xlat16_3;
vec4 u_xlat4;
mediump vec4 u_xlat16_4;
vec4 u_xlat5;
mediump vec3 u_xlat16_5;
vec3 u_xlat6;
bool u_xlatb6;
vec3 u_xlat7;
bool u_xlatb7;
vec4 u_xlat8;
mediump vec4 u_xlat16_8;
vec4 u_xlat9;
mediump vec4 u_xlat16_9;
float u_xlat10;
mediump vec3 u_xlat16_14;
mediump float u_xlat16_17;
float u_xlat23;
mediump float u_xlat16_23;
bool u_xlatb23;
mediump float u_xlat16_25;
float u_xlat33;
float u_xlat34;
float u_xlat35;
mediump float u_xlat16_36;
float u_xlat39;
float u_xlat40;
void main()
{
    u_xlat0 = in_POSITION0.yyyy * hlslcc_mtx4x4unity_ObjectToWorld[1];
    u_xlat0 = hlslcc_mtx4x4unity_ObjectToWorld[0] * in_POSITION0.xxxx + u_xlat0;
    u_xlat0 = hlslcc_mtx4x4unity_ObjectToWorld[2] * in_POSITION0.zzzz + u_xlat0;
    u_xlat1 = u_xlat0 + hlslcc_mtx4x4unity_ObjectToWorld[3];
    u_xlat2 = u_xlat1.yyyy * hlslcc_mtx4x4unity_MatrixVP[1];
    u_xlat2 = hlslcc_mtx4x4unity_MatrixVP[0] * u_xlat1.xxxx + u_xlat2;
    u_xlat2 = hlslcc_mtx4x4unity_MatrixVP[2] * u_xlat1.zzzz + u_xlat2;
    gl_Position = hlslcc_mtx4x4unity_MatrixVP[3] * u_xlat1.wwww + u_xlat2;
    u_xlat0.xyz = hlslcc_mtx4x4unity_ObjectToWorld[3].xyz * in_POSITION0.www + u_xlat0.xyz;
    u_xlat1.x = dot(in_NORMAL0.xyz, hlslcc_mtx4x4unity_WorldToObject[0].xyz);
    u_xlat1.y = dot(in_NORMAL0.xyz, hlslcc_mtx4x4unity_WorldToObject[1].xyz);
    u_xlat1.z = dot(in_NORMAL0.xyz, hlslcc_mtx4x4unity_WorldToObject[2].xyz);
    u_xlat33 = dot(u_xlat1.xyz, u_xlat1.xyz);
    u_xlat33 = inversesqrt(u_xlat33);
    u_xlat2.xyz = vec3(u_xlat33) * u_xlat1.xyz;
    u_xlat2.w = 1.0;
    u_xlat16_3.x = dot(unity_SHAr, u_xlat2);
    u_xlat16_3.y = dot(unity_SHAg, u_xlat2);
    u_xlat16_3.z = dot(unity_SHAb, u_xlat2);
    u_xlat16_4 = u_xlat2.yzzx * u_xlat2.xyzz;
    u_xlat16_5.x = dot(unity_SHBr, u_xlat16_4);
    u_xlat16_5.y = dot(unity_SHBg, u_xlat16_4);
    u_xlat16_5.z = dot(unity_SHBb, u_xlat16_4);
    u_xlat16_36 = u_xlat2.y * u_xlat2.y;
    u_xlat16_36 = u_xlat2.x * u_xlat2.x + (-u_xlat16_36);
    u_xlat16_4.xyz = unity_SHC.xyz * vec3(u_xlat16_36) + u_xlat16_5.xyz;
    vs_TEXCOORD2.xyz = u_xlat16_3.xyz + u_xlat16_4.xyz;
    u_xlat1.xzw = u_xlat0.xyz + (-_WorldSpaceCameraPos.xyz);
    u_xlat35 = dot(u_xlat1.xzw, u_xlat1.xzw);
    u_xlat6.x = inversesqrt(u_xlat35);
    u_xlat16_17 = u_xlat1.z * u_xlat6.x;
    u_xlat35 = u_xlat35 * u_xlat6.x + (-_FogStart);
    u_xlat35 = u_xlat35 * _FogRcpRange;
    u_xlat35 = clamp(u_xlat35, 0.0, 1.0);
    u_xlat6.x = u_xlat35 * u_xlat35;
    u_xlat35 = (-u_xlat35) * 2.0 + 3.0;
    u_xlat35 = u_xlat35 * u_xlat6.x;
    u_xlat35 = u_xlat35 * _FogEditorMultiplier;
    u_xlat16_3.x = -abs(u_xlat16_17) + 1.0;
    u_xlat16_14.x = u_xlat16_3.x * u_xlat16_3.x;
    u_xlat16_3.x = (-u_xlat16_14.x) * u_xlat16_3.x + 1.0;
    u_xlat16_14.x = (-u_xlat16_3.x) + 1.0;
    u_xlatb6 = 0.0<u_xlat16_17;
    u_xlat16_4.xyz = (bool(u_xlatb6)) ? _SkyboxTopColor.xyz : _SkyboxBottomColor.xyz;
    u_xlat16_14.xyz = u_xlat16_14.xxx * _SkyboxHorizonColor.xyz;
    vs_TEXCOORD3.xyz = u_xlat16_4.xyz * u_xlat16_3.xxx + u_xlat16_14.xyz;
    u_xlat6.x = dot(u_xlat1.xzw, _ShadowFadeLightDir.xyz);
    u_xlat1.xzw = (-_ShadowFadeLightDir.xyz) * u_xlat6.xxx + u_xlat1.xzw;
    u_xlat1.x = dot(u_xlat1.xzw, u_xlat1.xzw);
    u_xlat1.x = sqrt(u_xlat1.x);
    u_xlat6.xyz = u_xlat0.yyy * hlslcc_mtx4x4_StaticShadowMatrix[1].zxy;
    u_xlat6.xyz = hlslcc_mtx4x4_StaticShadowMatrix[0].zxy * u_xlat0.xxx + u_xlat6.xyz;
    u_xlat6.xyz = hlslcc_mtx4x4_StaticShadowMatrix[2].zxy * u_xlat0.zzz + u_xlat6.xyz;
    u_xlat6.xyz = u_xlat6.xyz + hlslcc_mtx4x4_StaticShadowMatrix[3].zxy;
    u_xlat7.xyz = u_xlat6.xyz * vec3(0.5, 0.5, 0.5) + vec3(0.5, 0.5, 0.5);
    vs_TEXCOORD4.z = u_xlat7.x + (-_StaticShadowBias);
    u_xlat16_3.x = (-u_xlat1.x) + _StaticShadowFadeEnd;
    u_xlat16_3.x = u_xlat16_3.x * _StaticShadowFadeInvRange;
    u_xlat16_3.x = clamp(u_xlat16_3.x, 0.0, 1.0);
    u_xlat23 = max(abs(u_xlat6.z), abs(u_xlat6.y));
    u_xlatb23 = u_xlat23>=1.0;
    u_xlat34 = u_xlat16_3.x * _StaticShadowStrength;
    u_xlat16_3.x = (u_xlatb23) ? 0.0 : u_xlat34;
    u_xlat6.xyz = u_xlat0.yyy * hlslcc_mtx4x4_DynamicShadowMatrix[1].zxy;
    u_xlat6.xyz = hlslcc_mtx4x4_DynamicShadowMatrix[0].zxy * u_xlat0.xxx + u_xlat6.xyz;
    u_xlat6.xyz = hlslcc_mtx4x4_DynamicShadowMatrix[2].zxy * u_xlat0.zzz + u_xlat6.xyz;
    u_xlat6.xyz = u_xlat6.xyz + hlslcc_mtx4x4_DynamicShadowMatrix[3].zxy;
    u_xlat6.xyz = u_xlat6.xyz * vec3(0.5, 0.5, 0.5) + vec3(0.5, 0.5, 0.5);
    vs_TEXCOORD7.z = u_xlat6.x + (-_DynamicShadowBias);
    u_xlat16_14.x = (-u_xlat1.x) + _DynamicShadowFadeEnd;
    u_xlat16_14.x = u_xlat16_14.x * _DynamicShadowFadeInvRange;
    u_xlat16_14.x = clamp(u_xlat16_14.x, 0.0, 1.0);
    u_xlat16_14.x = u_xlat16_14.x * _DynamicShadowStrength;
    u_xlat1.x = _GlobalTransitionDist + _GlobalDistArr[0];
    u_xlatb23 = u_xlat0.z<u_xlat1.x;
    if(u_xlatb23){
        u_xlat23 = (-_GlobalTransitionDist) + _GlobalDistArr[0];
        u_xlat1.x = (-u_xlat23) + u_xlat1.x;
        u_xlat23 = u_xlat0.z + (-u_xlat23);
        u_xlat1.x = float(1.0) / u_xlat1.x;
        u_xlat1.x = u_xlat1.x * u_xlat23;
        u_xlat1.x = clamp(u_xlat1.x, 0.0, 1.0);
        u_xlat23 = u_xlat1.x * -2.0 + 3.0;
        u_xlat1.x = u_xlat1.x * u_xlat1.x;
        u_xlat1.x = u_xlat1.x * u_xlat23;
        u_xlat4 = (-_GlobalMainColor[0]) + _GlobalMainColor[1];
        u_xlat5 = (-_GlobalSideColor[0]) + _GlobalSideColor[1];
        u_xlat23 = (-_GlobalTopSpreadsArr[0]) + _GlobalTopSpreadsArr[1];
        u_xlat23 = u_xlat1.x * u_xlat23 + _GlobalTopSpreadsArr[0];
        u_xlat4 = u_xlat1.xxxx * u_xlat4 + _GlobalMainColor[0];
        u_xlat5 = u_xlat1.xxxx * u_xlat5 + _GlobalSideColor[0];
        vs_TEXCOORD5 = u_xlat4;
        vs_TEXCOORD6 = u_xlat5;
        u_xlat16_23 = u_xlat23;
    } else {
        u_xlat6.x = _GlobalTransitionDist + _GlobalDistArr[1];
        u_xlat39 = _GlobalTransitionDist + _GlobalDistArr[2];
        u_xlatb7 = u_xlat0.z<u_xlat6.x;
        u_xlat40 = (-_GlobalTransitionDist) + _GlobalDistArr[1];
        u_xlat6.x = u_xlat6.x + (-u_xlat40);
        u_xlat40 = u_xlat0.z + (-u_xlat40);
        u_xlat6.x = float(1.0) / u_xlat6.x;
        u_xlat6.x = u_xlat6.x * u_xlat40;
        u_xlat6.x = clamp(u_xlat6.x, 0.0, 1.0);
        u_xlat40 = u_xlat6.x * -2.0 + 3.0;
        u_xlat6.x = u_xlat6.x * u_xlat6.x;
        u_xlat6.x = u_xlat6.x * u_xlat40;
        u_xlat4 = (-_GlobalMainColor[1]) + _GlobalMainColor[2];
        u_xlat5 = (-_GlobalSideColor[1]) + _GlobalSideColor[2];
        u_xlat40 = (-_GlobalTopSpreadsArr[1]) + _GlobalTopSpreadsArr[2];
        u_xlat40 = u_xlat6.x * u_xlat40 + _GlobalTopSpreadsArr[1];
        u_xlat4 = u_xlat6.xxxx * u_xlat4 + _GlobalMainColor[1];
        u_xlat5 = u_xlat6.xxxx * u_xlat5 + _GlobalSideColor[1];
        u_xlatb6 = u_xlat0.z<u_xlat39;
        u_xlat8.x = (-_GlobalTransitionDist) + _GlobalDistArr[2];
        u_xlat39 = u_xlat39 + (-u_xlat8.x);
        u_xlat8.x = u_xlat0.z + (-u_xlat8.x);
        u_xlat39 = float(1.0) / u_xlat39;
        u_xlat39 = u_xlat39 * u_xlat8.x;
        u_xlat39 = clamp(u_xlat39, 0.0, 1.0);
        u_xlat8.x = u_xlat39 * -2.0 + 3.0;
        u_xlat39 = u_xlat39 * u_xlat39;
        u_xlat39 = u_xlat39 * u_xlat8.x;
        u_xlat8 = (-_GlobalMainColor[2]) + _GlobalMainColor[3];
        u_xlat9 = (-_GlobalSideColor[2]) + _GlobalSideColor[3];
        u_xlat10 = (-_GlobalTopSpreadsArr[2]) + _GlobalTopSpreadsArr[3];
        u_xlat10 = u_xlat39 * u_xlat10 + _GlobalTopSpreadsArr[2];
        u_xlat8 = vec4(u_xlat39) * u_xlat8 + _GlobalMainColor[2];
        u_xlat9 = vec4(u_xlat39) * u_xlat9 + _GlobalSideColor[2];
        u_xlat16_8 = (bool(u_xlatb6)) ? u_xlat8 : _GlobalMainColor[3];
        u_xlat16_9 = (bool(u_xlatb6)) ? u_xlat9 : _GlobalSideColor[3];
        u_xlat16_25 = (u_xlatb6) ? u_xlat10 : _GlobalTopSpreadsArr[3];
        vs_TEXCOORD5 = (bool(u_xlatb7)) ? u_xlat4 : u_xlat16_8;
        vs_TEXCOORD6 = (bool(u_xlatb7)) ? u_xlat5 : u_xlat16_9;
        u_xlat16_23 = (u_xlatb7) ? u_xlat40 : u_xlat16_25;
    }
    vs_TEXCOORD1.w = u_xlat1.y * u_xlat33 + u_xlat16_23;
    vs_TEXCOORD0.xyz = u_xlat0.xyz;
    vs_TEXCOORD1.xyz = u_xlat2.xyz;
    vs_TEXCOORD3.w = u_xlat35;
    vs_TEXCOORD4.xy = u_xlat7.yz;
    vs_TEXCOORD4.w = u_xlat16_3.x;
    vs_TEXCOORD7.xy = u_xlat6.yz;
    vs_TEXCOORD7.w = u_xlat16_14.x;
    return;
}
